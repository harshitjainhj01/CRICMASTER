APP_NAME=CRICMASTER
APP_ENV=development

# The database path is relative to the backend working directory.
DATABASE_URL=sqlite:///./cricmaster.db

# Required by the CricketData current-match provider.
CRICKETDATA_API_KEY=

# Firebase Admin SDK file path relative to backend/.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Local browser frontend origin.
FRONTEND_URL=http://127.0.0.1:5500

# Optional RSS URL. Leave blank if no feed is configured.
CRICMASTER_NEWS_RSS_URL=
